{
  "installCommand": "npm install",
  "buildCommand": "cd server && npx prisma generate && cd ../client && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "server/src/generated/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:path*",     "destination": "/index.html" }
  ]
}
